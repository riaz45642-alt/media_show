# On Render use Supabase Connect > Session pooler (IPv4), not the direct db.* host.
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-your-region.pooler.supabase.com:5432/postgres
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_URL=http://localhost:5173,https://your-frontend.example.com
PORT=5000
NODE_ENV=development
# Optional. Render Free can use this ephemeral directory without a mounted disk.
# Files are lost when the service restarts or redeploys; use object storage for permanence.
UPLOAD_DIR=./uploads
# Public origin of this API, without a trailing slash. Used for permanent media URLs.
PUBLIC_API_URL=https://your-render-service.onrender.com
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_MAX_LIFETIME_SECONDS=1800
FIREBASE_PROJECT_ID=social-media-platform-57498
FIREBASE_CHECK_REVOKED=true

# For production, provide the Firebase service-account JSON as one line.
# Never expose this value through VITE_* variables or commit it to Git.
FIREBASE_SERVICE_ACCOUNT=

# Optional content moderation provider configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional in-process SHA-256 decision cache tuning.
MEDIA_MODERATION_CACHE_TTL_MS=86400000
MEDIA_MODERATION_CACHE_MAX_ENTRIES=500
