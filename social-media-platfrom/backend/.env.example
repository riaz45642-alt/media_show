DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_URL=http://localhost:5173
PORT=5000
FIREBASE_PROJECT_ID=social-media-platform-57498

# For production, provide the Firebase service-account JSON as one line.
# Never expose this value through VITE_* variables or commit it to Git.
FIREBASE_SERVICE_ACCOUNT=

# Optional content moderation provider configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
