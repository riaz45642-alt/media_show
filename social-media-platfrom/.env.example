# Local development:
VITE_API_URL=http://localhost:5000/api

# Recommended for reliable WebRTC across mobile networks and restrictive NATs.
# STUN-only calls still work where direct peer connectivity is available.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# In Cloudflare Pages, set VITE_API_URL under Settings > Variables and Secrets
# to the public HTTPS URL of the deployed Express API. Never use localhost there.
